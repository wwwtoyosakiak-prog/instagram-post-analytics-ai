OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4.1-mini
# Optional: account-specific OpenAI API keys.
# Set these in Vercel too, then register the env name on the account page.
# OPENAI_API_KEY_OZOPS=sk-your-account-key
INSTAGRAM_GRAPH_ACCESS_TOKEN=your-instagram-graph-api-token
# instagram_login: new Instagram Login API / facebook_login: legacy Facebook Login API
INSTAGRAM_GRAPH_API_MODE=instagram_login
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_OAUTH_CLIENT_ID=your-instagram-app-id
INSTAGRAM_OAUTH_CLIENT_SECRET=your-instagram-app-secret
INSTAGRAM_OAUTH_REDIRECT_URI=https://instagram-post-analytics-ai.vercel.app/api/instagram/oauth/callback
CRON_SECRET=replace-with-a-long-random-string
# Optional: set both values in Vercel to protect every screen and non-cron API.
# If only one is set, the app fails closed with HTTP 503.
APP_ACCESS_USER=your-login-name
APP_ACCESS_PASSWORD=replace-with-a-long-random-password
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
